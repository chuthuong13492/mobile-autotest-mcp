{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "coverageDecisionId": {
      "type": "string",
      "pattern": "^cov_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "needs_review"
      ]
    },
    "planHash": {
      "type": "string",
      "pattern": "^v\\d+:sha256:[0-9a-f]{64}$"
    },
    "requirementSetHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gatePolicyVersion": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "current": {
      "type": "boolean"
    },
    "findings": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "^(G[BR]-\\d{2}|INF-\\d{2})$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "review",
              "info"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 500
          },
          "refs": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            }
          }
        },
        "required": [
          "ruleId",
          "severity",
          "message",
          "refs"
        ],
        "additionalProperties": false
      }
    },
    "findingsNextCursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "requirementCoverage": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "numerator",
                "denominator",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "testCaseCoverage": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "numerator",
                "denominator",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceCodeCoverage": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "numerator",
                "denominator",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "platformCoverage": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "numerator",
                "denominator",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "regressionCoverage": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "numerator",
                "denominator",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "executionCoverage": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "numerator",
                "denominator",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "requirementCoverage",
        "testCaseCoverage",
        "sourceCodeCoverage",
        "platformCoverage",
        "regressionCoverage",
        "executionCoverage"
      ],
      "additionalProperties": false
    },
    "requirementStatus": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirementId": {
            "type": "string",
            "pattern": "^REQ-\\d{3}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "unmapped",
              "mapped",
              "eligible",
              "executed",
              "passing",
              "failing",
              "blocked",
              "excepted",
              "unverified"
            ]
          }
        },
        "required": [
          "requirementId",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "nextSteps": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  },
  "required": [
    "coverageDecisionId",
    "decision",
    "planHash",
    "requirementSetHash",
    "gatePolicyVersion",
    "current",
    "findings",
    "findingsNextCursor",
    "metrics",
    "requirementStatus",
    "nextSteps"
  ],
  "additionalProperties": false
}
