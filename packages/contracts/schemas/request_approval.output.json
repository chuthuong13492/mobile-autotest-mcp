{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "approvalRequestId": {
      "type": "string",
      "pattern": "^apr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "scopeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requiredAssurance": {
      "type": "string",
      "enum": [
        "AL1",
        "AL2",
        "AL3"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "fulfilled",
        "expired",
        "withdrawn"
      ]
    },
    "approvalId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^appr_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "instructions": {
      "type": "object",
      "properties": {
        "cliCommand": {
          "type": "string",
          "maxLength": 300
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "cliCommand",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "elicitationOutcome": {
      "type": "string",
      "enum": [
        "not_offered",
        "accepted_insufficient",
        "accepted",
        "declined",
        "cancelled"
      ]
    }
  },
  "required": [
    "approvalRequestId",
    "scopeDigest",
    "requiredAssurance",
    "status",
    "approvalId",
    "instructions",
    "elicitationOutcome"
  ],
  "additionalProperties": false
}
