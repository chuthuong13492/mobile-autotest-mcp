{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "github"
      ]
    },
    "manual": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 1024
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "labels": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "changedFiles": {
          "maxItems": 3000,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        }
      },
      "required": [
        "body"
      ],
      "additionalProperties": false
    },
    "github": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "maxLength": 255
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "number": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "owner",
        "name",
        "number"
      ],
      "additionalProperties": false
    },
    "bodyOffset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "workspace",
    "source"
  ],
  "additionalProperties": false
}
