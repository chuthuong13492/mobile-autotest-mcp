{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "planId": {
      "type": "string",
      "pattern": "^plan_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "planHash": {
      "type": "string",
      "pattern": "^v\\d+:sha256:[0-9a-f]{64}$"
    },
    "hashVersion": {
      "type": "number",
      "const": 1
    },
    "testCaseCount": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "testCases": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TC-\\d{3}$"
          },
          "clientKey": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "riskTier": {
            "type": "string",
            "enum": [
              "R0",
              "R1",
              "R2",
              "R3"
            ]
          },
          "eligibility": {
            "type": "string"
          },
          "targetRef": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^TT-[a-z0-9-]+-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "must",
              "should",
              "could"
            ]
          }
        },
        "required": [
          "id",
          "clientKey",
          "title",
          "riskTier",
          "eligibility",
          "targetRef",
          "priority"
        ],
        "additionalProperties": false
      }
    },
    "riskSummary": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "R0",
          "R1",
          "R2",
          "R3"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "required": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "eligibilitySummary": {
      "type": "object",
      "properties": {
        "eligible": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "ineligible": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "eligible",
        "ineligible"
      ],
      "additionalProperties": false
    },
    "unresolvedTargets": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clientKey": {
            "type": "string"
          },
          "targetPath": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "clientKey",
          "targetPath",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "planId": {
              "type": "string",
              "pattern": "^plan_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "version": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "planHash": {
              "type": "string",
              "pattern": "^v\\d+:sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "planId",
            "version",
            "planHash"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "untrustedFields": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    }
  },
  "required": [
    "planId",
    "version",
    "planHash",
    "hashVersion",
    "testCaseCount",
    "testCases",
    "riskSummary",
    "eligibilitySummary",
    "unresolvedTargets",
    "warnings",
    "supersedes",
    "untrustedFields"
  ],
  "additionalProperties": false
}
