{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "partial": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "stdout",
              "stderr",
              "runner_json",
              "junit",
              "xcresult",
              "screenshot",
              "video",
              "log",
              "coverage",
              "report"
            ]
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "mimeType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "quarantined": {
            "type": "boolean"
          },
          "uri": {
            "type": "string",
            "pattern": "^autotest:\\/\\/runs\\/run_[0-9A-HJKMNP-TV-Z]{26}\\/artifacts\\/art_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "redactionApplied": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "producer": {
                "type": "string",
                "maxLength": 64
              },
              "toolVersion": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "producer",
              "toolVersion"
            ],
            "additionalProperties": false
          },
          "excerpt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8192
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "artifactId",
          "kind",
          "sizeBytes",
          "sha256",
          "mimeType",
          "quarantined",
          "uri",
          "redactionApplied",
          "truncated",
          "provenance",
          "excerpt"
        ],
        "additionalProperties": false
      }
    },
    "quarantinedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "untrustedFields": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    }
  },
  "required": [
    "runId",
    "partial",
    "artifacts",
    "quarantinedCount",
    "nextCursor",
    "untrustedFields"
  ],
  "additionalProperties": false
}
