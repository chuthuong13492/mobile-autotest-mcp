{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "rulesetVersion": {
      "type": "string",
      "maxLength": 32
    },
    "summary": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "product_defect",
          "test_defect",
          "environment_failure",
          "pre_existing",
          "unknown"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "analysisId": {
            "type": "string",
            "pattern": "^fa_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "resultId": {
            "type": "string",
            "pattern": "^res_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "class": {
            "type": "string",
            "enum": [
              "product_defect",
              "test_defect",
              "environment_failure",
              "pre_existing",
              "unknown"
            ]
          },
          "subtype": {
            "type": "string",
            "enum": [
              "behavior",
              "assertion",
              "setup",
              "flaky",
              "infrastructure",
              "dependency",
              "device",
              "toolchain",
              "baseline_failure",
              "known_failure",
              "inconclusive"
            ]
          },
          "strength": {
            "type": "string",
            "enum": [
              "hypothesis",
              "supported"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "observations": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 500
                },
                "artifactId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "text",
                "artifactId"
              ],
              "additionalProperties": false
            }
          },
          "inference": {
            "type": "string",
            "maxLength": 1000
          },
          "alternatives": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "class": {
                  "type": "string",
                  "enum": [
                    "product_defect",
                    "test_defect",
                    "environment_failure",
                    "pre_existing",
                    "unknown"
                  ]
                },
                "subtype": {
                  "type": "string",
                  "enum": [
                    "behavior",
                    "assertion",
                    "setup",
                    "flaky",
                    "infrastructure",
                    "dependency",
                    "device",
                    "toolchain",
                    "baseline_failure",
                    "known_failure",
                    "inconclusive"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "class",
                "subtype",
                "confidence"
              ],
              "additionalProperties": false
            }
          },
          "nextSteps": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "required": [
          "analysisId",
          "resultId",
          "class",
          "subtype",
          "strength",
          "confidence",
          "observations",
          "inference",
          "alternatives",
          "nextSteps"
        ],
        "additionalProperties": false
      }
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "runId",
    "rulesetVersion",
    "summary",
    "analyses",
    "nextCursor"
  ],
  "additionalProperties": false
}
