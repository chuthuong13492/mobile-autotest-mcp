{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "resultIds": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^res_[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "limit": {
      "default": 25,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "runId"
  ],
  "additionalProperties": false
}
