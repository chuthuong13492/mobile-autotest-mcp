{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "state": {
      "type": "string",
      "const": "queued"
    },
    "authorizationId": {
      "type": "string",
      "pattern": "^authz_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "targetsCount": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "queuePosition": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pollAfterMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_:]*$"
          },
          "message": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "runId",
    "state",
    "authorizationId",
    "targetsCount",
    "queuePosition",
    "pollAfterMs",
    "limitations"
  ],
  "additionalProperties": false
}
