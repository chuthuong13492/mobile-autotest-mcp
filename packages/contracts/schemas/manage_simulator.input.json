{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "boot",
        "shutdown",
        "create",
        "erase",
        "delete",
        "install",
        "acquire"
      ]
    },
    "deviceId": {
      "type": "string",
      "maxLength": 128
    },
    "create": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "ios",
            "android"
          ]
        },
        "deviceType": {
          "type": "string",
          "maxLength": 100
        },
        "runtime": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "platform",
        "deviceType",
        "runtime"
      ],
      "additionalProperties": false
    },
    "install": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "string",
          "maxLength": 64
        },
        "appPath": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": [
        "workspace",
        "appPath"
      ],
      "additionalProperties": false
    },
    "acquire": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "ios",
            "android"
          ]
        },
        "deviceType": {
          "type": "string",
          "maxLength": 100
        },
        "runtime": {
          "type": "string",
          "maxLength": 100
        },
        "allowAdopt": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "platform"
      ],
      "additionalProperties": false
    },
    "runId": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "approvalId": {
      "type": "string",
      "pattern": "^appr_[0-9A-HJKMNP-TV-Z]{26}$"
    }
  },
  "required": [
    "action"
  ],
  "additionalProperties": false
}
