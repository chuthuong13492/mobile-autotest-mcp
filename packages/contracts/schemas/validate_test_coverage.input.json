{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "planId": {
      "type": "string",
      "pattern": "^plan_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "planHash": {
      "type": "string",
      "pattern": "^v\\d+:sha256:[0-9a-f]{64}$"
    },
    "findingsCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [
    "planId",
    "planHash"
  ],
  "additionalProperties": false
}
