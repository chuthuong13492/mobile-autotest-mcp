{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "planId": {
      "type": "string",
      "pattern": "^plan_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "planHash": {
      "type": "string",
      "pattern": "^v\\d+:sha256:[0-9a-f]{64}$"
    },
    "targets": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^TC-\\d{3}$"
          },
          {
            "type": "string",
            "pattern": "^TT-[a-z0-9-]+-[0-9a-f]{12}$"
          }
        ]
      }
    },
    "environment": {
      "default": "local",
      "type": "string",
      "maxLength": 200
    },
    "devices": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "timeouts": {
      "type": "object",
      "properties": {
        "runMs": {
          "type": "integer",
          "minimum": 60000,
          "maximum": 14400000
        },
        "attemptMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "targetMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "retry": {
      "type": "object",
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "coverage": {
          "default": false,
          "type": "boolean"
        },
        "screenshots": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    }
  },
  "required": [
    "planId",
    "planHash"
  ],
  "additionalProperties": false
}
