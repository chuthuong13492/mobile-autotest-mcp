{
  "name": "mobile-autotest-mcp",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Mobile AutoTest MCP: PR-driven, policy-governed mobile test orchestration (MCP server + CLI + Agent Skill).",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit && vitest run --project slow",
    "test:coverage": "vitest run --coverage",
    "test:resilience": "vitest run resilience",
    "e2e:devices": "AUTOTEST_E2E_DEVICES=1 vitest run --project slow",
    "bench": "node bench/bench.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:links": "node scripts/check-doc-links.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm docs:links && pnpm depcruise && pnpm depcruise:negative && pnpm test",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages apps && node scripts/check-boundaries.ts",
    "depcruise:negative": "node scripts/check-boundaries-negative.ts",
    "release:build": "node scripts/build-release.ts",
    "release:pack": "node scripts/build-release.ts --pack"
  },
  "devDependencies": {
    "@autotest/adapter-android": "workspace:*",
    "@autotest/adapter-appium": "workspace:*",
    "@autotest/adapter-flutter": "workspace:*",
    "@autotest/adapter-ios": "workspace:*",
    "@autotest/adapter-react-native": "workspace:*",
    "@autotest/adapter-sdk": "workspace:*",
    "@autotest/cli": "workspace:*",
    "@autotest/core": "workspace:*",
    "@autotest/evidence": "workspace:*",
    "@autotest/exec": "workspace:*",
    "@autotest/storage": "workspace:*",
    "@autotest/mcp-server": "workspace:*",
    "@autotest/policy": "workspace:*",
    "@autotest/workflow": "workspace:*",
    "@autotest/workspace": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
